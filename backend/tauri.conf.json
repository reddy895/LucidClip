{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "LucidClip",
  "version": "0.1.0",
  "identifier": "com.lucidclip.app",
  "build": {
    "beforeDevCommand": "npm run dev:frontend",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:frontend",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LucidClip",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "center": true
      },
      {
        "label": "clipboard-popup",
        "title": "LucidClip History",
        "url": "index.html#popup",
        "width": 480,
        "height": 560,
        "minWidth": 360,
        "minHeight": 420,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$LOCALDATA/LucidClip/screenshots/**",
          "$LOCALDATA/lucidclip/screenshots/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
